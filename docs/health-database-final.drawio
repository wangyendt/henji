<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram id="health-final" name="health 最终数据库">
    <mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="health 最终数据库结构（PostgreSQL / personal_knowledge.health）" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="核心原则：只有 2 张同步物理表；业务类型作为 JSONB 对象保存；统计通过只读 SQL View 展开，不复制、不遗失数据。" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1720" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="① 物理存储层：真正落盘的表" style="swimlane;startSize=38;container=1;pointerEvents=0;rounded=1;html=1;fontSize=16;fontStyle=1;fillColor=#f8fbff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1720" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;TABLE health.sync_events&lt;/b&gt;&#xa;&#xa;追加写入的事件日志（永不覆盖）&#xa;• cursor / event_id / device_id&#xa;• entity_type / entity_id / operation&#xa;• schema_version / occurred_at / received_at&#xa;• payload JSONB / dedupe_key&#xa;&#xa;&lt;font color=&quot;#2563eb&quot;&gt;用途：审计、去重、断点拉取、故障恢复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="10">
          <mxGeometry x="30" y="60" width="500" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;TABLE health.sync_objects&lt;/b&gt;&#xa;&#xa;每个业务对象的最新状态（含墓碑）&#xa;• entity_type + entity_id（逻辑主键）&#xa;• latest_cursor / latest_event_id / device_id&#xa;• operation / deleted / schema_version&#xa;• occurred_at / updated_at&#xa;• payload JSONB / dedupe_key&#xa;&#xa;&lt;font color=&quot;#2563eb&quot;&gt;用途：多设备同步后的当前真相&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="10">
          <mxGeometry x="610" y="60" width="520" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;图片文件（不放 PostgreSQL BLOB）&lt;/b&gt;&#xa;&#xa;当前：手机 App 私有目录&#xa;以后：hx470 对象存储 / 文件目录&#xa;&#xa;数据库只保存：&#xa;• asset_key / sha256&#xa;• mime_type / size&#xa;• captured_at / source&#xa;&#xa;&lt;font color=&quot;#b45309&quot;&gt;分享截图可追溯，但数据库保持轻量&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="1210" y="60" width="450" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="同一对象的多次事件 → 最新一条" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f7fb3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="10" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="引用元数据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#d79b00;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="10" source="13" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="② 业务对象层：sync_objects.entity_type + payload JSONB（这些不是额外物理表）" style="swimlane;startSize=38;container=1;pointerEvents=0;rounded=1;html=1;fontSize=16;fontStyle=1;fillColor=#fcfaff;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="1720" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;profile_record&lt;/b&gt;&#xa;身高 / 性别 / 生日&#xa;目标体重 / 单位偏好" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="30" y="70" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;weight_record&lt;/b&gt;&#xa;体重 / BMI / 体脂率 / 水分&#xa;肌肉 / 骨量 / 蛋白质 / BMR&#xa;内脏脂肪 / 身体年龄…" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="280" y="70" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;meal_record&lt;/b&gt;&#xa;日期 / 餐次 / 总热量&#xa;foods[] 菜品明细 / 营养 / 建议&#xa;原始分析文本 / 图片引用" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="560" y="70" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;health_import_record&lt;/b&gt;&#xa;一次 vivo 健康截图导入&#xa;图片哈希 / OCR-LLM 版本 / 置信度&#xa;origin_import_id 的来源对象" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="20">
          <mxGeometry x="850" y="70" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;daily_wellness_record&lt;/b&gt;（旧）&#xa;当前已有 1 条运动截图对象&#xa;迁移后写 tombstone，事件历史保留" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;" vertex="1" parent="20">
          <mxGeometry x="1190" y="70" width="330" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;daily_activity_record&lt;/b&gt;&#xa;日期 / 步数 / 距离&#xa;活动热量 / 活动分钟&#xa;origin_import_id" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="590" y="250" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;workout_record&lt;/b&gt;&#xa;运动类型 / 开始结束时间&#xa;距离 / 热量 / 平均与最高心率&#xa;origin_import_id" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="900" y="250" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="28" value="&lt;b&gt;sleep_session_record&lt;/b&gt;&#xa;入睡 / 醒来 / 总时长&#xa;深睡 / 浅睡 / REM / 清醒&#xa;origin_import_id" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="20">
          <mxGeometry x="1230" y="250" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="29" value="解析出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="20" source="24" target="26">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="30" value="解析出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="20" source="24" target="27">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="解析出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="20" source="24" target="28">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="拆分迁移" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;dashed=1;strokeColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="20" source="25" target="27">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="③ 类型化查询层：health.* SQL VIEW（只读投影，不产生孤儿数据）" style="swimlane;startSize=38;container=1;pointerEvents=0;rounded=1;html=1;fontSize=16;fontStyle=1;fillColor=#f8fff8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1720" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;体重域视图&lt;/b&gt;&#xa;&#xa;&lt;b&gt;weight_measurements&lt;/b&gt;&#xa;展开所有体成分字段&#xa;&#xa;&lt;b&gt;daily_weight&lt;/b&gt;&#xa;每天 14:00 前最后一次；首日无此限制" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="40">
          <mxGeometry x="30" y="70" width="350" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="&lt;b&gt;饮食域视图&lt;/b&gt;&#xa;&#xa;&lt;b&gt;meals&lt;/b&gt;：每顿汇总&#xa;&lt;b&gt;meal_foods&lt;/b&gt;：foods[] 展开，每项保留 meal_id&#xa;&lt;b&gt;daily_nutrition&lt;/b&gt;：每日热量与营养汇总" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="40">
          <mxGeometry x="410" y="70" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;活动 / 运动 / 睡眠视图&lt;/b&gt;&#xa;&#xa;&lt;b&gt;daily_activity&lt;/b&gt;：步数、距离、活动热量&#xa;&lt;b&gt;workouts&lt;/b&gt;：每次运动详情&#xa;&lt;b&gt;sleep_sessions&lt;/b&gt;：每次睡眠及阶段" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="40">
          <mxGeometry x="840" y="70" width="410" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="&lt;b&gt;导入与数据质量&lt;/b&gt;&#xa;&#xa;&lt;b&gt;health_imports&lt;/b&gt;：导入来源、哈希、解析版本&#xa;&lt;b&gt;sync_diagnostics&lt;/b&gt;：设备、游标、墓碑、失败状态&#xa;&#xa;可定位重复分享、解析失败和断点同步" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="40">
          <mxGeometry x="1280" y="70" width="380" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="45" value="&lt;b&gt;daily_energy_balance（综合日视图）&lt;/b&gt;&#xa;日期 + 选定体重/BMR + 饮食摄入 + 日常活动消耗 + 运动消耗&#xa;&lt;b&gt;估算净热量 = 摄入 − 基础代谢 − 活动 − 运动&lt;/b&gt;&#xa;供首页“今日 / 本周减重趋势”和昨日对比使用" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#b7e1cd;strokeColor=#4f9d75;strokeWidth=2;" vertex="1" parent="40">
          <mxGeometry x="360" y="330" width="1000" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="46" value="体重 + BMR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f9d75;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="40" source="41" target="45">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="47" value="摄入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f9d75;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.42;entryY=0;" edge="1" parent="40" source="42" target="45">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="48" value="活动 + 运动" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f9d75;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.72;entryY=0;" edge="1" parent="40" source="43" target="45">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1430" width="360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="50"><mxGeometry x="35" y="40" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="52" value="物理表" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="50"><mxGeometry x="62" y="38" width="55" height="20" as="geometry"/></mxCell>
        <mxCell id="53" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="50"><mxGeometry x="120" y="40" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="54" value="业务对象" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="50"><mxGeometry x="147" y="38" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="55" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="50"><mxGeometry x="220" y="40" width="22" height="16" as="geometry"/></mxCell>
        <mxCell id="56" value="只读视图" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="50"><mxGeometry x="247" y="38" width="65" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
